{
  "name": "lyrebird-challenge",
  "version": "1.0.0",
  "description": "Clinic appointment system REST API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/swagger": "~9.7.0",
    "@fastify/swagger-ui": "~6.0.0",
    "better-sqlite3": "~12.10.0",
    "fastify": "~5.8.5",
    "uuid": "~14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@types/better-sqlite3": "~7.6.13",
    "@types/node": "~25.9.2",
    "@types/uuid": "~11.0.0",
    "eslint": "~10.4.1",
    "eslint-config-prettier": "~10.1.8",
    "prettier": "~3.8.4",
    "tsx": "~4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.61.0",
    "vitest": "~4.1.8"
  }
}
